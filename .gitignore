# Rust / Cargo
/target
**/*.rs.bk
# NOTE: Cargo.lock is deliberately COMMITTED (and built with --locked).
# The toolchain is pinned to Rust 1.75 (Windows 7 support) and that cargo
# cannot parse edition-2024 manifests, so the dependency graph has to be
# frozen instead of re-resolved on every build.  Refresh it with
# ./scripts/refresh-lockfile.sh.

# Android build output (generated by workflows / scripts)
android-build/
*.apk
*.aab
*.jks
*.keystore

# Editor
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Local scripts output
dist/

# Vendored source cache (downloaded by scripts/prepare-vendor.sh)
vendor/.cache/

# Python bytecode (scripts/*.py)
__pycache__/
*.pyc
