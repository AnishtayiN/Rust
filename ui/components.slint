// ============================== Buttons =====================================
// kind: 0 = primary (gradient), 1 = ghost (outline), 2 = soft (panel fill)
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon-name: "";
    in property <int> kind: 0;
    in property <bool> enabled: true;
    callback clicked <=> touch.clicked;

    height: 44px;
    border-radius: 12px;
    background: root.kind == 0 ? Theme.accent-grad :
        root.kind == 2 ? Theme.panel2 : #00000000;
    border-width: root.kind == 1 ? 1.5px : 0px;
    border-color: root.kind == 1 ? Theme.stroke : #00000000;
    opacity: root.enabled ? 1.0 : 0.45;

    states [
        hover when touch.has_hover && root.enabled : {
            background: root.kind == 0 ? Theme.accent-grad :
                root.kind == 2 ? Theme.panel2.darker(10%) : Theme.panel2;
        }
        down when touch.pressed && root.enabled : {
            background: root.kind == 0 ? Theme.accent-grad.darker(12%) :
                root.kind == 2 ? Theme.panel2.darker(18%) : Theme.panel2.darker(10%);
        }
    ]
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;

        if root.icon-name != "" : IconBox {
            width: 17px;
            height: 17px;
            name: root.icon-name;
            tint: root.kind == 0 ? Theme.accent-text : Theme.text-soft;
        }
        Text {
            text: root.text;
            color: root.kind == 0 ? Theme.accent-text : Theme.text;
            font-size: 14px;
            font-weight: 650;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        width: 100%;
        height: 100%;
    }
}

export component NavButton inherits Rectangle {
    in property <string> icon-name;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> narrow: false;
    callback clicked <=> touch.clicked;

    height: root.narrow ? 54px : 46px;
    border-radius: 12px;
    background: root.active ? Theme.accent-soft : #00000000;

    states [
        hover when touch.has_hover && !root.active : {
            background: Theme.panel2;
        }
        down when touch.pressed : {
            background: Theme.panel2.darker(10%);
        }
    ]
    animate background { duration: 120ms; }

    if root.narrow : VerticalLayout {
        alignment: center;
        IconBox {
            width: 20px;
            height: 20px;
            name: root.icon-name;
            tint: root.active ? Theme.accent : Theme.text-faint;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-faint;
            font-size: 10px;
            font-weight: 600;
        }
    } if !root.narrow : HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        IconBox {
            width: 20px;
            height: 20px;
            name: root.icon-name;
            tint: root.active ? Theme.accent : Theme.text-faint;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-soft;
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        width: 100%;
        height: 100%;
    }
}

// ============================== Small pieces ================================
export component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon-name: "";
    in property <int> kind: 0; // 0 neutral, 1 ok, 2 bad, 3 accent, 4 gold, 5 info

    height: 24px;
    width: root.icon-name == "" ? label-el.width + 20px : label-el.width + 37px;
    border-radius: 999px;
    background: root.kind == 1 ? Theme.ok-soft :
        root.kind == 2 ? Theme.bad-soft :
        root.kind == 3 ? Theme.accent-soft :
        root.kind == 4 ? Theme.gold-soft :
        root.kind == 5 ? Theme.info-soft : Theme.panel2;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        alignment: center;

        if root.icon-name != "" : IconBox {
            width: 12px;
            height: 12px;
            name: root.icon-name;
            tint: root.kind == 1 ? Theme.ok :
                root.kind == 2 ? Theme.bad :
                root.kind == 3 ? Theme.accent :
                root.kind == 4 ? Theme.gold :
                root.kind == 5 ? Theme.info : Theme.text-soft;
        }
        Text {
            id: label-el;
            text: root.text;
            color: root.kind == 1 ? Theme.ok :
                root.kind == 2 ? Theme.bad :
                root.kind == 3 ? Theme.accent :
                root.kind == 4 ? Theme.gold :
                root.kind == 5 ? Theme.info : Theme.text-soft;
            font-size: 11px;
            font-weight: 650;
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0.0;
    in property <length> bar-height: 8px;

    height: root.bar-height;
    border-radius: 999px;
    background: Theme.stroke;

    fill := Rectangle {
        width: parent.width * Math.min(1.0, Math.max(0.0, root.value));
        height: parent.height;
        border-radius: 999px;
        background: Theme.accent-grad;
    }
}

export component StatCard inherits Rectangle {
    in property <string> icon-name;
    in property <string> value;
    in property <string> label;

    height: 104px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.panel;

    Rectangle {
        width: 38px;
        height: 38px;
        x: 16px;
        y: 16px;
        border-radius: 11px;
        background: Theme.accent-soft;

        IconBox {
            width: 19px;
            height: 19px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            tint: Theme.accent;
        }
    }

    Text {
        x: 16px;
        y: 62px;
        text: root.value;
        color: Theme.text;
        font-size: 22px;
        font-weight: 800;
    }

    Text {
        x: 16px;
        y: 86px;
        text: root.label;
        color: Theme.text-faint;
        font-size: 11px;
    }
}

export component SectionHead inherits Rectangle {
    in property <string> icon-name: "spark";
    in property <string> kicker: "";
    in property <string> title;
    in property <string> subtitle: "";

    height: 44px;

    Rectangle {
        width: 34px;
        height: 34px;
        x: 0px;
        y: 2px;
        border-radius: 10px;
        background: Theme.accent-soft;

        IconBox {
            width: 17px;
            height: 17px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            tint: Theme.accent;
        }
    }

    Text {
        x: 46px;
        y: 1px;
        text: root.kicker == "" ? root.title : root.kicker;
        color: root.kicker == "" ? Theme.text : Theme.accent;
        font-size: 16px;
        font-weight: 800;
    }

    Text {
        x: 46px;
        y: 24px;
        text: root.kicker == "" ? root.subtitle : root.title;
        color: root.kicker == "" ? Theme.text-faint : Theme.text-soft;
        font-size: 11px;
    }
}

// ============================== Top bar =====================================
export component TopBar inherits Rectangle {
    in property <string> title;
    in property <bool> show-back: true;
    in property <string> xp: "0";
    in property <string> streak: "0";
    callback back-clicked;

    height: 54px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.panel;

    if root.show-back : Rectangle {
        width: 36px;
        height: 36px;
        x: 9px;
        y: 9px;
        border-radius: 11px;

        states [
            hover when back-touch.has_hover : {
                background: Theme.panel2;
            }
            down when back-touch.pressed : {
                background: Theme.panel2.darker(10%);
            }
        ]
        animate background { duration: 120ms; }

        IconBox {
            width: 17px;
            height: 17px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "back";
            tint: Theme.text-soft;
        }

        back-touch := TouchArea {
            mouse-cursor: pointer;
            width: 100%;
            height: 100%;
            clicked => { root.back-clicked(); }
        }
    }

    Text {
        x: root.show-back ? 56px : 20px;
        y: (parent.height - self.height) / 2;
        width: parent.width - (root.show-back ? 76px : 40px) - 190px;
        text: root.title;
        color: Theme.text;
        font-size: 16px;
        font-weight: 800;
        overflow: elide;
    }

    Rectangle {
        width: 74px;
        height: 28px;
        x: parent.width - 174px;
        y: 13px;
        border-radius: 9px;
        background: Theme.accent-soft;

        IconBox {
            width: 13px;
            height: 13px;
            x: 10px;
            y: 7px;
            name: "bolt";
            tint: Theme.accent;
        }
        Text {
            x: 28px;
            y: (parent.height - self.height) / 2;
            text: root.xp;
            color: Theme.accent;
            font-size: 12.5px;
            font-weight: 800;
        }
    }

    Rectangle {
        width: 74px;
        height: 28px;
        x: parent.width - 92px;
        y: 13px;
        border-radius: 9px;
        background: Theme.gold-soft;

        IconBox {
            width: 13px;
            height: 13px;
            x: 10px;
            y: 7px;
            name: "star";
            tint: Theme.gold;
        }
        Text {
            x: 28px;
            y: (parent.height - self.height) / 2;
            text: root.streak;
            color: Theme.gold;
            font-size: 12.5px;
            font-weight: 800;
        }
    }
}

// ============================== Content pieces ==============================
export component SearchBox inherits Rectangle {
    in-out property <string> query: "";
    callback changed(string);

    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.panel;

    IconBox {
        width: 16px;
        height: 16px;
        x: 14px;
        y: 14px;
        name: "search";
        tint: Theme.text-faint;
    }

    TextInput {
        x: 40px;
        y: 5px;
        width: parent.width - 52px - (root.query == "" ? 0px : 36px);
        height: parent.height - 10px;
        color: Theme.text;
        font-size: 13.5px;
        text: root.query;
        single-line: true;
        edited => {
            root.query = self.text;
            root.changed(root.query);
        }
        accepted => {
            root.query = self.text;
            root.changed(root.query);
        }
    }

    if root.query != "" : Rectangle {
        width: 28px;
        height: 28px;
        x: parent.width - 36px;
        y: 8px;
        border-radius: 9px;

        states [
            hover when x-touch.has_hover : {
                background: Theme.panel2;
            }
        ]
        animate background { duration: 120ms; }

        Text {
            text: "x";
            color: Theme.text-soft;
            font-size: 14px;
            font-weight: 700;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 1px;
        }

        x-touch := TouchArea {
            mouse-cursor: pointer;
            width: 100%;
            height: 100%;
            clicked => {
                root.query = "";
                root.changed("");
            }
        }
    }
}

export component LessonRow inherits Rectangle {
    in property <int> id;
    in property <string> icon-name;
    in property <string> title;
    in property <string> subtitle;
    in property <string> meta;      // e.g. "12 min · 40 XP"
    in property <string> best;      // best quiz result, "" if none
    in property <int> status;       // 0 locked, 1 in progress, 2 done
    in property <float> progress;   // 0..1
    callback clicked;

    height: 88px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.panel;
    opacity: root.status == 0 ? 0.55 : 1.0;

    states [
        hover when touch.has_hover && root.status != 0 : {
            background: Theme.panel2;
            border-color: Theme.accent;
        }
        down when touch.pressed && root.status != 0 : {
            background: Theme.panel2.darker(10%);
        }
    ]
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Rectangle {
        width: 46px;
        height: 46px;
        x: 14px;
        y: 21px;
        border-radius: 13px;
        background: root.status == 2 ? Theme.ok-soft :
            root.status == 1 ? Theme.accent-soft : Theme.panel2;

        IconBox {
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            tint: root.status == 2 ? Theme.ok :
                root.status == 1 ? Theme.accent : Theme.text-faint;
        }
    }

    Text {
        x: 74px;
        y: 14px;
        width: parent.width - 74px - 150px;
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 700;
        overflow: elide;
    }

    Text {
        x: 74px;
        y: 38px;
        width: parent.width - 74px - 150px;
        text: root.subtitle;
        color: Theme.text-faint;
        font-size: 11.5px;
        overflow: elide;
    }

    Rectangle {
        x: 74px;
        y: 63px;
        width: parent.width - 74px - 170px;
        height: 6px;
        border-radius: 999px;
        background: Theme.stroke;

        fill := Rectangle {
            width: parent.width * root.progress;
            height: parent.height;
            border-radius: 999px;
            background: root.status == 2 ? Theme.ok : Theme.accent-grad;
        }
    }

    Rectangle {
        width: 130px;
        height: 100%;
        x: parent.width - 140px;

        VerticalLayout {
            padding-top: 22px;
            spacing: 3px;
            alignment: center;

            if root.status == 2 : Pill { text: "Completed"; icon-name: "check"; kind: 1; }
            if root.best != "" : Pill { text: "Best " + root.best; icon-name: "target"; kind: 3; }
            if root.status == 1 : Pill { text: "In progress"; icon-name: "clock"; kind: 5; }
            if root.status == 0 : Pill { text: "Locked"; icon-name: "lock"; kind: 0; }

            Text {
                text: root.meta;
                color: Theme.text-faint;
                font-size: 10.5px;
                horizontal-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.status != 0;
        mouse-cursor: pointer;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component QuizOption inherits Rectangle {
    in property <string> letter: "A";
    in property <string> label;
    in property <int> state: 0; // 0 idle, 1 picked-correct, 2 picked-wrong, 3 reveal-correct, 4 dim
    callback clicked;

    height: 54px;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: root.state == 1 ? Theme.ok :
        root.state == 2 ? Theme.bad :
        root.state == 3 ? Theme.ok :
        root.state == 4 ? Theme.stroke : Theme.stroke;
    background: root.state == 1 ? Theme.ok-soft :
        root.state == 2 ? Theme.bad-soft :
        root.state == 3 ? Theme.ok-soft :
        root.state == 4 ? Theme.panel : Theme.panel;
    opacity: root.state == 4 ? 0.6 : 1.0;

    states [
        hover when touch.has_hover && root.state == 0 : {
            border-color: Theme.accent;
            background: Theme.panel2;
        }
        down when touch.pressed && root.state == 0 : {
            background: Theme.panel2.darker(10%);
        }
    ]
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Rectangle {
        width: 30px;
        height: 30px;
        x: 12px;
        y: 12px;
        border-radius: 9px;
        background: root.state == 1 ? Theme.ok :
            root.state == 2 ? Theme.bad :
            root.state == 3 ? Theme.ok : Theme.panel2;

        if root.state == 1 || root.state == 3 : IconBox {
            width: 15px;
            height: 15px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "check";
            tint: #ffffff;
        } if root.state == 2 : IconBox {
            width: 15px;
            height: 15px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "xmark";
            tint: #ffffff;
        } if root.state != 1 && root.state != 2 && root.state != 3 : Text {
            text: root.letter;
            color: Theme.text-soft;
            font-size: 13px;
            font-weight: 800;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 1px;
        }
    }

    Text {
        x: 54px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 70px;
        text: root.label;
        color: Theme.text;
        font-size: 13.5px;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    touch := TouchArea {
        enabled: root.state == 0;
        mouse-cursor: pointer;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component CodeView inherits Rectangle {
    in property <string> filename: "main.rs";
    in property <string> lang: "Rust";
    in property <[CodeLine]> lines;
    in property <int> current: -1;
    in property <int> block: -1; // -1: show all lines

    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.stroke;
    height: 44px + body.height;

    Rectangle {
        height: 44px;
        border-radius: 14px;
        background: Theme.panel2;

        Text {
            x: 14px;
            y: (parent.height - self.height) / 2;
            text: root.filename;
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            x: parent.width - 70px;
            y: (parent.height - self.height) / 2;
            text: root.lang;
            color: Theme.accent;
            font-size: 10.5px;
            font-weight: 700;
        }
    }

    body := VerticalLayout {
        y: 44px;
        width: parent.width;
        height: self.preferred-height;
        padding-top: 6px;
        padding-bottom: 8px;
        spacing: 0px;

        for line[index] in root.lines : Rectangle {
            height: 24px;
            visible: root.block == -1 || line.block == root.block;
            background: line.no == root.current ? Theme.accent-soft : #00000000;

            Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: 30px;
                text: "" + (index + 1);
                color: Theme.text-faint;
                font-size: 10.5px;
                horizontal-alignment: center;
            }

            Text {
                x: 48px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 58px;
                text: line.text;
                color: line.color == 0 ? #dbe6ff :
                    line.color == 1 ? #ff9e6e :
                    line.color == 2 ? #a5e075 :
                    line.color == 3 ? #6d7896 :
                    line.color == 4 ? #7cc7ff :
                    line.color == 5 ? #4fd6c3 :
                    line.color == 6 ? #c3a6ff : #ffd166;
                font-size: 12px;
                font-family: "Consolas";
            }
        }
    }
}

export component ExplorerCode inherits CodeView {
    filename: "lab.rs";
    lang: "Rust";
    block: -1;
}

export component CheatRow inherits Rectangle {
    in property <string> icon-name;
    in property <string> title;
    in property <string> body;
    in property <bool> open: false;
    callback toggled;

    border-radius: 14px;
    border-width: 1px;
    border-color: root.open ? Theme.accent : Theme.stroke;
    background: root.open ? Theme.panel2 : Theme.panel;
    height: 58px + body.height;

    Rectangle {
        height: 58px;
        border-radius: 14px;

        Rectangle {
            width: 36px;
            height: 36px;
            x: 14px;
            y: 11px;
            border-radius: 11px;
            background: Theme.accent-soft;

            IconBox {
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.icon-name;
                tint: Theme.accent;
            }
        }

        Text {
            x: 62px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 62px - 46px;
            text: root.title;
            color: Theme.text;
            font-size: 13.5px;
            font-weight: 700;
            overflow: elide;
        }

        Rectangle {
            width: 26px;
            height: 26px;
            x: parent.width - 36px;
            y: 16px;
            border-radius: 8px;
            background: Theme.panel2;

            Text {
                text: root.open ? "-" : "+";
                color: Theme.text-soft;
                font-size: 15px;
                font-weight: 700;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 1px;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            width: 100%;
            height: 100%;
            clicked => {
                root.open = !root.open;
                root.toggled();
            }
        }
    }

    body := VerticalLayout {
        y: 58px;
        width: parent.width - 32px;
        x: 16px;
        height: root.open ? self.preferred-height : 0px;
        visible: root.open;
        spacing: 8px;

        Rectangle {
            height: 1px;
            background: Theme.stroke;
        }

        Text {
            text: root.body;
            color: Theme.text-soft;
            font-size: 12px;
            font-family: "monospace";
            wrap: word-wrap;
            width: 100%;
        }
    }
}

export component AchCard inherits Rectangle {
    in property <string> icon-name;
    in property <string> title;
    in property <string> desc;
    in property <bool> got: false;

    height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.got ? Theme.gold : Theme.stroke;
    background: root.got ? Theme.gold-soft : Theme.panel;
    opacity: root.got ? 1.0 : 0.75;

    Rectangle {
        width: 46px;
        height: 46px;
        x: 14px;
        y: 23px;
        border-radius: 13px;
        background: root.got ? Theme.gold-soft : Theme.panel2;

        IconBox {
            width: 24px;
            height: 24px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            tint: root.got ? Theme.gold : Theme.text-faint;
        }
    }

    Text {
        x: 74px;
        y: 18px;
        width: parent.width - 74px - 100px;
        text: root.title;
        color: root.got ? Theme.gold : Theme.text;
        font-size: 14px;
        font-weight: 800;
        overflow: elide;
    }

    Text {
        x: 74px;
        y: 40px;
        width: parent.width - 74px - 100px;
        text: root.desc;
        color: Theme.text-faint;
        font-size: 11px;
        wrap: word-wrap;
    }

    Rectangle {
        width: 80px;
        height: 100%;
        x: parent.width - 92px;
        VerticalLayout {
            alignment: center;
            if root.got : Pill { text: "Earned"; icon-name: "check"; kind: 4; }
            if !root.got : Pill { text: "Locked"; icon-name: "lock"; kind: 0; }
        }
    }
}
