// Rust Academy - reusable UI components
// Colors come from the global Theme (ui/theme.slint).

import { Theme } from "theme.slint";

export struct CodeLine {
    no: int,
    block: int,
    text: string,
    color: int, // 0 default, 1 keyword, 2 string, 3 comment, 4 number, 5 type, 6 function, 7 macro
}

export struct LessonInfo {
    id: int,
    module: int,
    icon: string,
    title: string,
    subtitle: string,
    duration: string,
    xp: string,
    best: string,       // best quiz score text, "" if none
    status: int,        // 0 locked, 1 in progress, 2 done
    progress: float,
}

export struct ModuleInfo {
    id: int,
    icon: string,
    title: string,
    desc: string,
    done: int,
    total: int,
}

export struct Block {
    id: int,
    kind: int,          // 0 heading, 1 text, 2 code, 3 tip, 4 warning
    title: string,
    text: string,
    file: string,
}

export struct QuizQ {
    q: string,
    a: string,
    b: string,
    c: string,
    d: string,
    state0: int,        // 0 idle, 1 picked-correct, 2 picked-wrong, 3 reveal-correct, 4 dim
    state1: int,
    state2: int,
    state3: int,
    was-correct: bool,
    why: string,
    answer: int,        // index of the correct option (0..3); UI never reads it
}

export struct CheatEntry {
    id: int,
    icon: string,
    title: string,
    body: string,
    open: bool,
}

export struct VarEntry {
    name: string,
    value: string,
    dirty: bool,
}

export struct Achievement {
    id: int,
    icon: string,
    title: string,
    desc: string,
    earned: bool,
}

export struct DayBar {
    label: string,
    value: float,
}

// ============================== Icons =======================================
// Data-driven icon: small vector glyphs, tinted by `tint`.
export component IconBox inherits Rectangle {
    in property <string> name: "";
    in property <color> tint: Theme.text-soft;

    if root.name == "home" : Image { width: 100%; height: 100%; source: @image-url("../assets/icons/home.svg"); colorize: root.tint; image-fit: contain; }
    if root.name == "book" : Image { width: 100%; height: 100%; source: @image-url("../assets/icons/book.svg"); colorize: root.tint; image-fit: contain; }
    if root.name == "code" : Image { width: 100%; height: 100%; source: @image-url("../assets/icons/code.svg"); colorize: root.tint; image-fit: contain; }
    if root.name == "terminal" : Image { width: 100%; height: 100%; source: @image-url("../assets/icons/terminal.svg"); colorize: root.tint; image-fit: contain; }
