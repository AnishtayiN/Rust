    if root.name == "medal" : Image { width: 100%; height: 100%; source: @image-url("../assets/icons/medal.svg"); colorize: root.tint; image-fit: contain; }
    if root.name == "gear" : Image { width: 100%; height: 100%; source: @image-url("../assets/icons/gear.svg"); colorize: root.tint; image-fit: contain; }
